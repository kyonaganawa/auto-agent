{
  "professional_settings": {
    "work_hours": {
      "start": "09:00",
      "end": "18:00",
      "timezone": "America/Los_Angeles",
      "working_days": ["monday", "tuesday", "wednesday", "thursday", "friday"]
    },
    "focus_blocks": {
      "enabled": true,
      "default_duration_minutes": 90,
      "pomodoro_mode": {
        "enabled": true,
        "work_minutes": 25,
        "break_minutes": 5,
        "long_break_minutes": 15,
        "pomodoros_before_long_break": 4
      },
      "dnd_during_focus": true
    },
    "task_management": {
      "auto_prioritize": true,
      "priority_algorithm": "eisenhower_matrix",
      "daily_task_limit": 7,
      "overdue_reminder_enabled": true,
      "completion_celebration": true
    },
    "meetings": {
      "auto_create_notes": true,
      "prep_reminder_minutes": 15,
      "action_item_extraction": true,
      "auto_task_creation": true,
      "meeting_buffer_minutes": 5
    },
    "daily_routine": {
      "morning_briefing_time": "08:00",
      "end_of_day_review_time": "18:00",
      "weekly_review_day": "friday",
      "weekly_review_time": "16:00",
      "monthly_review_day": "last_friday",
      "monthly_review_time": "15:00"
    },
    "notifications": {
      "daily_briefing": true,
      "task_reminders": true,
      "meeting_prep": true,
      "end_of_day_summary": true,
      "weekly_report": true,
      "overdue_alerts": true,
      "achievement_celebrations": true
    },
    "code_assistance": {
      "enabled": true,
      "auto_code_review": true,
      "test_generation_suggestions": true,
      "documentation_prompts": true,
      "style_guide_enforcement": true,
      "security_scanning": true
    },
    "career_development": {
      "skill_tracking": true,
      "portfolio_reminders": true,
      "linkedin_post_suggestions": true,
      "learning_goal_tracking": true,
      "achievement_logging": true
    }
  },
  "integrations": {
    "calendar": {
      "enabled": false,
      "provider": "google_calendar",
      "api_key_env": "GOOGLE_CALENDAR_API_KEY"
    },
    "git": {
      "enabled": true,
      "auto_commit_eod": false,
      "commit_message_template": "conventional_commits"
    },
    "slack": {
      "enabled": false,
      "webhook_url_env": "SLACK_WEBHOOK_URL",
      "channels": {
        "personal_updates": "#personal-updates",
        "team_updates": "#team-updates"
      }
    },
    "jira": {
      "enabled": false,
      "url": "",
      "api_token_env": "JIRA_API_TOKEN",
      "auto_sync_tasks": false
    }
  },
  "metrics": {
    "track_focus_time": true,
    "track_task_completion": true,
    "track_meeting_time": true,
    "track_code_quality": true,
    "track_energy_levels": true,
    "generate_daily_report": true,
    "generate_weekly_report": true,
    "generate_monthly_report": true
  },
  "ai_assistance": {
    "code_suggestions": true,
    "documentation_generation": true,
    "presentation_outlines": true,
    "email_drafting": true,
    "meeting_summaries": true,
    "task_breakdown": true,
    "priority_suggestions": true
  },
  "preferences": {
    "notification_quiet_hours": {
      "enabled": true,
      "start": "20:00",
      "end": "08:00"
    },
    "weekend_mode": {
      "enabled": true,
      "reduce_notifications": true,
      "emergency_only": true
    },
    "language": "en",
    "date_format": "YYYY-MM-DD",
    "time_format": "24h"
  }
}
